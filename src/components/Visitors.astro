---
/**
 * Visitors —— 访客统计数字（地图本体在页脚，见 VisitorMap.astro）
 *
 * 这里只放标题与数字，实际的世界地图渲染在 Footer 里。
 * 数字由 VisitorMap.astro 里的脚本按 id 填充（#visit-total / #visit-regions）。
 */
import { siteConfig } from "../config";
---

<section id="visitors" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900"
        >
          Visitors
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="lg:col-span-8">
        <p class="text-lg sm:text-xl leading-relaxed text-gray-600">
          地图上的每一个亮点，都是一次来自远方的到访。
        </p>

        <div class="mt-8 flex flex-wrap items-baseline gap-x-12 gap-y-5">
          <div class="flex items-baseline gap-2.5">
            <span
              id="visit-total"
              class="text-4xl sm:text-5xl font-bold tabular-nums"
              style={`color: ${siteConfig.accentColor}`}>—</span
            >
            <span class="text-base sm:text-lg text-gray-500">次访问</span>
          </div>
          <div class="flex items-baseline gap-2.5">
            <span
              id="visit-regions"
              class="text-4xl sm:text-5xl font-bold tabular-nums text-gray-900"
              >—</span
            >
            <span class="text-base sm:text-lg text-gray-500"
              >个国家和地区</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
